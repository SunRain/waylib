@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 支持的组件列表
set(WaylibShared_KNOWN_COMPONENTS SharedServer)

# 设置默认组件（如果没有指定组件）
if(NOT WaylibShared_FIND_COMPONENTS)
    set(WaylibShared_FIND_COMPONENTS SharedServer)
endif()

# 检查请求的组件是否有效
foreach(component ${WaylibShared_FIND_COMPONENTS})
    if(NOT component IN_LIST WaylibShared_KNOWN_COMPONENTS)
        set(WaylibShared_FOUND False)
        set(WaylibShared_NOT_FOUND_MESSAGE "Unknown component: ${component}")
        return()
    endif()
endforeach()

# 加载请求的组件
foreach(component ${WaylibShared_FIND_COMPONENTS})
    if(component STREQUAL "SharedServer")
        include(${CMAKE_CURRENT_LIST_DIR}/WaylibSharedServerConfig.cmake)
        if(NOT TARGET WaylibShared::SharedServer)
            set(WaylibShared_FOUND False)
            set(WaylibShared_NOT_FOUND_MESSAGE "Component ${component} not found")
            return()
        endif()
        set(WaylibShared_${component}_FOUND TRUE)
    endif()
endforeach()

# 检查所有组件是否都已找到
set(WaylibShared_FOUND TRUE)
foreach(component ${WaylibShared_FIND_COMPONENTS})
    if(NOT WaylibShared_${component}_FOUND)
        set(WaylibShared_FOUND False)
        set(WaylibShared_NOT_FOUND_MESSAGE "Component ${component} not found")
        return()
    endif()
endforeach()

check_required_components(WaylibShared)
